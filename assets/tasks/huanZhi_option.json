{
    "option": {
        
    // 第一个选项：模式
        "指定模式": {
            "type": "select",
            "label": "选择试炼模式(请主界面开始)",
            "default_case": "试炼入口",
            "cases": [
                {
                    "name": "试炼入口",
                    "pipeline_override": {
                        // 覆盖“进入”节点的 next，指向普通入口
                        "幻之试炼_进入": {
                            "next": ["幻之试炼_试炼入口"]
                        }
                    }
                },
                {
                    "name": "修罗试炼",
                    "pipeline_override": {
                        "幻之试炼_进入": {
                            "next": ["幻之试炼_修罗试炼"]
                        }
                    }
                }
            ]
        },

        // 选项的键名，界面上的标签会用它关联任务
        "指定流派": {
            // 选项类型：select = 下拉单选
            "type": "select",

            // 界面上显示给用户看的文字
            "label": "选择幻之试炼流派(修罗没配置)",

            // 用户不选时，默认使用哪个 case
            "default_case": "奥义领域",

            // cases 数组：每个元素就是一种可选分支
            "cases": [
                {
                    // case 的名字，会显示在下拉菜单里
                    "name": "刃具精通",

                    // pipeline_override：用户选了这个 case 后，
                    // 要覆盖哪些节点的哪些字段
                    "pipeline_override": {
                        // 节点名（必须已在 Pipeline 中存在）
                        "幻之试炼_选择流派": {
                            // 要覆盖的字段：next
                            // 新值：指向刃具精通的翻页节点
                            "next": ["幻之试炼_翻页_刃具精通_上一页"]
                        }
                    }
                },
                {
                    "name": "奥义领域",
                    "pipeline_override": {
                        "幻之试炼_选择流派": {
                            "next": ["幻之试炼_翻页_奥义领域_下一页"]
                        }
                    }
                },
                {
                    "name": "秘卷大师",
                    "pipeline_override": {
                        "幻之试炼_选择流派": {
                            "next": ["幻之试炼_翻页_秘卷大师_上一页"]
                        }
                    }
                },
                {
                    "name": "医疗忍者",
                    "pipeline_override": {
                        "幻之试炼_选择流派": {
                            "next": ["幻之试炼_翻页_医疗忍者_上一页"]
                        }
                    }
                },
                {
                    "name": "最佳伙伴",
                    "pipeline_override": {
                        "幻之试炼_选择流派": {
                            "next": ["幻之试炼_翻页_最佳伙伴_下一页"]
                        }
                    }
                },
                {
                    "name": "禁法之术",
                    "pipeline_override": {
                        "幻之试炼_选择流派": {
                            "next": ["幻之试炼_翻页_禁法之术_下一页"]
                        }
                    }
                }
                // ... 其他流派
            ]
        },
        "指定忍者": {
            "type": "select",
            "label": "选择幻之试炼忍者",
            "default_case": "斑",
            "cases": [
                {
                    "name": "花火",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_花火"]
                        }
                    }
                },
                {
                    "name": "斑",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_斑"]
                        }
                    }
                },
                {
                    "name": "卡卡西",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_卡卡西"]
                        }
                    }
                }
                ,
                {
                    "name": "大蛇丸",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_大蛇丸"]
                        }
                    }
                },
                {
                    "name": "柱间",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_柱间"]
                        }
                    }
                },
                {
                    "name": "小佐助",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_小佐助"]
                        }
                    }
                },
                {
                    "name": "骨架",
                    "pipeline_override": {
                        "幻之试炼_选择忍者": {
                            "next": ["幻之试炼_忍者_骨架"]
                        }
                    }
                }
            ]
        },
         "忍者分类": {
            "type": "select",
            "label": "选择忍者分类(第七班可以刷人数,其余暂没配置)",
            "default_case": "第七班",
            "cases": [
                {
                    "name": "第七班",
                    "pipeline_override": {
                        // 覆盖“进入”节点的 next，指向普通入口
                        "幻之试炼_忍者分类": {
                            "next": ["幻之试炼_忍者_第七班"]
                        }
                    }
                },
                {
                    "name": "无用之人",
                    "pipeline_override": {
                        "幻之试炼_忍者分类": {
                            "next": ["幻之试炼_忍者_无用之人"]
                        }
                    }
                }
            ]
        }

    }
}