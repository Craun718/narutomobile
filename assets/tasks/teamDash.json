{
    "task": [
        {
            "name": "小队突袭",
            "entry": "team_dash",
            "default_check": true,
            "description": "组织里有人用和自己一样忍者时,建议关闭借组织助战",
            "group": [
                "daily"
            ],
            "option": [
                "借组织助战",
                "小队突袭处理自动战斗"
            ]
        }
    ],
    "option": {
        "借组织助战": {
            "type": "switch",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "team_dash_invite_page": {
                            "next": [
                                "team_dash_invite_ninja",
                                "[JumpBack]can_not_invite",
                                "dash_or_exit",
                                "retry_failed"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "team_dash_invite_page": {
                            "next": [
                                "dash_or_exit",
                                "retry_failed"
                            ]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "小队突袭处理自动战斗": {
            "type": "switch",
            "description": "小队突袭里面开着自动战斗,表现为一进入战斗就自动战斗;这个自动战斗会保留到下一局.如果不清楚账号开着自动战斗,或者不想开，此时开启这个选项",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "team_dash_not_in_auto_battle": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes"
                }
            ],
            "default_case": "No"
        }
    }
}
