{
    "debug": {
        "next": "set_touchs"
    },
    "set_touchs": {
        "timeout": 100,
        "next": [
            "[JumpBack]close_touches",
            "[JumpBack]show_touches",
            "set_pointer_location"
        ]
    },
    "close_touches": {
        "max_hit": 1,
        "action": "Shell",
        "cmd": "settings put system show_touches 0",
        "next": "hide_pointer_location",
        "focus": {
            "Node.Action.Starting": "关闭触控显示"
        }
    },
    "show_touches": {
        "enabled": false,
        "max_hit": 1,
        "action": "Shell",
        "cmd": "settings put system show_touches 1",
        "focus": {
            "Node.Action.Starting": "开启触控显示"
        }
    },
    "set_pointer_location": {
        "next": [
            "[JumpBack]hide_pointer_location",
            "[JumpBack]show_pointer_location",
            "others_settings"
        ]
    },
    "hide_pointer_location": {
        "max_hit": 1,
        "action": "Shell",
        "cmd": "settings put system pointer_location 0",
        "focus": {
            "Node.Action.Starting": "隐藏指针位置"
        }
    },
    "show_pointer_location": {
        "enabled": false,
        "max_hit": 1,
        "action": "Shell",
        "cmd": "settings put system pointer_location 1",
        "focus": {
            "Node.Action.Starting": "显示指针位置"
        }
    },
    "others_settings": {
        "action": "StopTask"
    }
}
